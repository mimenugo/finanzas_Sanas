# Database Configuration
# Local example:
# DATABASE_URL="mysql://root:@localhost:3306/finanzas_sanas"
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# JWT Configuration
JWT_ACCESS_SECRET="change-this-to-a-secure-random-string"
JWT_REFRESH_SECRET="change-this-to-another-secure-random-string"
# JWT_SECRET is kept only for older local helpers that still read it as fallback.
JWT_SECRET="change-this-only-if-needed"
ACCESS_TOKEN_EXPIRY="1h"
REFRESH_TOKEN_EXPIRY="7d"

# Server Configuration
PORT=5000
NODE_ENV=development
# Public frontend URL. For multiple frontends, separate with commas.
CLIENT_URL=http://localhost:5174
# Public backend URL without /api. Required for OAuth callbacks and public webhooks.
API_PUBLIC_URL=http://localhost:5000

# File Upload Configuration
# 7 MB in bytes
MAX_FILE_SIZE=7340032

# Google Drive Upload Configuration
# Optional. Used only for direct Google Drive document upload with Service Account.
# If your Google organization blocks JSON keys, leave these empty and use the Google Sheets OAuth setup from the admin panel.
GOOGLE_DRIVE_CLIENT_EMAIL=""
GOOGLE_DRIVE_PRIVATE_KEY=""
GOOGLE_DRIVE_FOLDER_ID=""

# Notes:
# - Stripe, SMTP notifications, Google Sheets OAuth, payment gateways and bank accounts
#   are configured from the admin panel and saved in the database.
# - Never commit real passwords, API keys, webhook secrets, OAuth client secrets or certificates.
